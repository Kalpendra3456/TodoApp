# ---------- Stage 1: Build Stage ----------
FROM node:18 AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build


# ---------- Stage 2: Production Stage ----------
FROM node:18-alpine

WORKDIR /app

# Copy only required files from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

RUN npm install --production

EXPOSE 3000

CMD ["node", "dist/app.js"]
